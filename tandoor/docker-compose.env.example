# Add these lines to your tandoor service in ~/docker/tandoor/docker-compose.yml
# Required for https://jpc.wyrm-pike.ts.net:10000/tandoor/

environment:
  - SCRIPT_NAME=/tandoor
  - STATIC_URL=/tandoor/static/
  - MEDIA_URL=/tandoor/media/
  - JS_REVERSE_SCRIPT_PREFIX=/tandoor/
  - REVERSE_PROXY_COUNT=2
