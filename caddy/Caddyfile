# =============================================================================
# JPC — Caddy behind Tailscale Serve
# =============================================================================
#
# Tailscale Serve (run on jpc after Caddy is up):
#   sudo tailscale serve reset
#   sudo tailscale serve --bg --https=443    http://127.0.0.1:8180
#   sudo tailscale serve --bg --https=10000  http://127.0.0.1:8190
#
# PUBLIC:  https://jpc.wyrm-pike.ts.net
# ADMIN:   https://jpc.wyrm-pike.ts.net:10000/<app>/
#
# Docker host ports:
#   vaultwarden 8081 | nextcloud 8088 | tandoor 8050 | sabnzbd 8080
#   sonarr 8989 | radarr 7878 | portainer 9000 | plex 32400
# =============================================================================

{
	email noxylem@proton.me
}

# Vaultwarden only — Tailscale :443
:8180 {
	log
	reverse_proxy host.docker.internal:8081
}

# Admin apps — Tailscale :10000
:8190 {
	log

	# Trailing-slash redirects (one-time; stops /sonarr → /sonarr/)
	redir /sonarr /sonarr/ 308
	redir /radarr /radarr/ 308
	redir /nextcloud /nextcloud/ 308
	redir /tandoor /tandoor/ 308
	redir /portainer /portainer/ 308
	redir /sabnzbd /sabnzbd/ 308

	# -------------------------------------------------------------------------
	# Sonarr / Radarr — DO NOT use handle_path here
	# -------------------------------------------------------------------------
	# Servarr UrlBase is /sonarr or /radarr. The app must receive the FULL path
	# (e.g. /sonarr/login), same as nginx: proxy_pass http://127.0.0.1:8989;
	# handle_path STRIPS /sonarr and causes ERR_TOO_MANY_REDIRECTS.
	#
	# In each app (Settings → General → show advanced):
	#   URL Base:     /sonarr  or  /radarr
	#   Enable SSL:   OFF
	#   Use Proxy:    OFF  (outbound proxy — not this reverse proxy)
	# -------------------------------------------------------------------------
	handle /sonarr* {
		reverse_proxy host.docker.internal:8989 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Host {http.request.hostport}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /radarr* {
		reverse_proxy host.docker.internal:7878 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Host {http.request.hostport}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle_path /nextcloud/* {
		reverse_proxy host.docker.internal:8088 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Host {http.request.hostport}
			header_up X-Forwarded-Proto https
		}
	}
	handle_path /tandoor/* {
		reverse_proxy host.docker.internal:8050 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Host {http.request.hostport}
			header_up X-Forwarded-Proto https
		}
	}
	handle_path /portainer/* {
		reverse_proxy host.docker.internal:9000 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Proto https
		}
	}
	handle_path /sabnzbd/* {
		reverse_proxy host.docker.internal:8080 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Proto https
		}
	}
	handle /plex/* {
		reverse_proxy host.docker.internal:32400
	}
	handle / {
		respond "Admin: /nextcloud /tandoor /portainer /sonarr /radarr /sabnzbd /plex" 200
	}
}
